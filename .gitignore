build/bin
build/electron
node_modules
# Build output, but .gitkeep must stay tracked: main.go embeds this directory,
# so it has to exist in a fresh checkout before the frontend is ever built.
frontend/dist/*
!frontend/dist/.gitkeep
/tui
frontend/wailsjs/runtime
frontend/wailsjs/go
# Anchored: an unanchored `dist` also matches frontend/dist, and git cannot
# re-include a file whose parent directory is excluded — which silently defeated
# the !frontend/dist/.gitkeep rule above.
/dist
# mkdocs-material's social plugin writes its rendered card cache here
# (.cache/plugin/social). It only appears in CI, because the plugin is gated
# `enabled: !ENV [CI, false]` — which is why ci.yml's clean-tree assertion after
# `make docs-build` failed while every local docs build looked fine.
.cache/
site
build/windows/*.pfx
build/windows/*.key
build/windows/*.crt
report.html
__pycache__
# Generated by the docs-downloads target from docs/downloads.md.in — the
# template is what is tracked, so a local `make docs-serve` cannot dirty the
# working tree by substituting a version into a tracked file.
#
# docs/downloads.md stayed *tracked* until S15 even though it was listed here:
# gitignore has no effect on a path git already tracks. It looked clean only
# because `git describe` still returned the version the committed copy was
# generated from — the first tag after that would have rewritten it and failed
# ci.yml's "the build left no tracked file modified" assertion.
docs/version.json
docs/version-beta.json
docs/downloads.md

# Vestigial: the real Node projects are frontend/ and electron/. A root install
# leaves a lockfile with no matching package.json, which confuses `npm ci`.
# (node_modules itself is covered by the unanchored rule at the top.)
/package-lock.json

graphify-out/cost.json
graphify-out/cache/

# UI redesign screenshots (roadmap/ui-redesign.md). Regenerated on demand by
# roadmap/ui-redesign/capture.py into before/, after/ and per-step folders;
# only the script and audit.md are tracked.
/roadmap/ui-redesign/*/
